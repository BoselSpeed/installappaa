<?xml version="1.0" encoding="utf-8"?>
<!--
    Reader toolbar actions.

    showAsAction is deliberately restricted to the three most-used actions so the
    overflow stays short; the rest is one tap away in the overflow menu.

    action_bookmark_toggle is a checkable item: its state follows the current page
    rather than being a plain action, so the reader can see at a glance whether
    the page is already saved.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_pdf_search"
        android:title="@string/reader_search"
        app:iconTint="@color/reader_on_surface"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_bookmark_toggle"
        android:checkable="true"
        android:icon="@drawable/ic_pdf_bookmark"
        android:title="@string/reader_bookmarks"
        app:iconTint="@color/reader_on_surface"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_toc"
        android:title="@string/reader_table_of_contents"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_bookmarks"
        android:title="@string/reader_bookmarks"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_notes"
        android:title="@string/reader_notes"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_highlight"
        android:title="@string/reader_highlight"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_settings"
        android:title="@string/reader_settings"
        app:showAsAction="never" />
</menu>