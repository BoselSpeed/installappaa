<?xml version="1.0" encoding="utf-8"?>
<!--
    Day palette. Mirrors the web app's paper + ink monochrome, so the native
    reader is not visually jarring next to the Capacitor WebView.
    values-night/reader_colors.xml holds the dark equivalents.
-->
<resources>
    <color name="reader_background">#FFFAFAF8</color>
    <color name="reader_surface">#FFFFFFFF</color>
    <color name="reader_on_surface">#FF1A1A1A</color>
    <color name="reader_on_surface_variant">#FF6B6B6B</color>
    <color name="reader_accent">#FF7A5C3E</color>
    <color name="reader_divider">#FFE3E0DB</color>

    <!--
        Night overlay. Applied on top of the rendered PDF page rather than
        behind it, because PdfView draws its own opaque bitmap; see
        PdfReaderActivity.applyNightMode().
    -->
    <color name="reader_night_overlay">#99000000</color>

    <!-- Highlight swatches: classic annotation colours, legible on paper. -->
    <color name="reader_highlight_yellow">#FFFFE082</color>
    <color name="reader_highlight_green">#FFC5E1A5</color>
    <color name="reader_highlight_blue">#FF90CAF9</color>
    <color name="reader_highlight_pink">#FFF48FB1</color>
</resources>
