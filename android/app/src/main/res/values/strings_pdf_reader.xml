<?xml version="1.0" encoding="utf-8"?>
<!--
    Reader strings live in their own file so the app-level strings.xml, which
    Capacitor generates from the web app, stays untouched. That matters: a
    `npx cap sync` rewrites strings.xml and would otherwise drop this file's
    neighbours out of sync.
-->
