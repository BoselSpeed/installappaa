<?xml version="1.0" encoding="utf-8"?>
<!-- Saved pages for the current book. Tapping an entry jumps to it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/reader_gutter"
        android:text="@string/reader_bookmarks"
        android:textColor="@color/reader_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bookmarksRecycler"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_bookmark" />

    <!-- Shown when the book has no bookmarks yet. -->
    <TextView
        android:id="@+id/bookmarksEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/reader_bookmarks_empty"
        android:textColor="@color/reader_on_surface_variant"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
