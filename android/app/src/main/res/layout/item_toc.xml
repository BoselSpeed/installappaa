<?xml version="1.0" encoding="utf-8"?>
<!--
    One table-of-contents entry.

    Indentation is driven by tocLevel so chapters sit inside their section.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tocRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/reader_gutter">

    <TextView
        android:id="@+id/tocTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/reader_on_surface"
        tools:text="Book of Zakat" />

    <TextView
        android:id="@+id/tocPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/reader_on_surface_variant"
        android:textSize="13sp"
        tools:text="142" />
</LinearLayout>
