<?xml version="1.0" encoding="utf-8"?>
<!--
    Night palette. Same names as the day values so every reference in the
    layouts and code switches automatically with the system dark mode.
-->
<resources>
    <color name="reader_background">#FF121110</color>
    <color name="reader_surface">#FF1C1B19</color>
    <color name="reader_on_surface">#FFEDEAE4</color>
    <color name="reader_on_surface_variant">#FFA9A49C</color>
    <!-- Warm accent kept from the day palette, lifted for contrast on dark. -->
    <color name="reader_accent">#FFCBAA86</color>
    <color name="reader_divider">#FF34322E</color>

    <!-- Lighter than the day value: a full-strength black would crush the page. -->
    <color name="reader_night_overlay">#66000000</color>

    <!-- Desaturated swatches so highlights stay readable without glaring. -->
    <color name="reader_highlight_yellow">#FF6E5A1E</color>
    <color name="reader_highlight_green">#FF3D5B2C</color>
    <color name="reader_highlight_blue">#FF25455E</color>
    <color name="reader_highlight_pink">#FF5E2C41</color>
</resources>
